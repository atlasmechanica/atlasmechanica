{
  "name": "atlas-mechanica",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "experiments/renderers/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'experiments/renderers/svg-bakeoff/tests/**'",
    "catalog:schema:check": "vitest run packages/catalog/src/editorSchema.test.ts",
    "renderer:bakeoff:check": "npm run check --workspace @atlasmechanica/svg-bakeoff",
    "web:check": "npm run check --workspace @atlasmechanica/web",
    "check": "npm run typecheck && npm run test && npm run renderer:bakeoff:check && npm run web:check"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "ajv": "8.20.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.0"
  }
}
