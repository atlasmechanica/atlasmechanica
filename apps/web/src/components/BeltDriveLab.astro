---
import MechanismLab from './MechanismLab.astro';

interface Props {
  routing: 'open' | 'crossed';
}

const { routing } = Astro.props;
const modelId = `foundation:belt-drive:${routing}`;
const title = routing === 'open' ? 'Open Belt Drive' : 'Crossed Belt Drive';
---

<MechanismLab
  modelId={modelId}
  adapterId="atlas.analytic-belt.v0"
  title={title}
/>
