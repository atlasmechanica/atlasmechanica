---
interface Props {
  routing: 'open' | 'crossed';
}

const { routing } = Astro.props;
const crossed = routing === 'crossed';
const inputId = `belt-${routing}-angle`;
const centerId = `belt-${routing}-center`;
const rpmId = `belt-${routing}-rpm`;
const centerMin = crossed ? 95 : 45;
const direction = crossed ? 'Reversed' : 'Same';
---

<section
  class="mechanism-lab"
  data-belt-drive-lab
  data-routing={routing}
  aria-label={`Interactive ${routing} belt drive experiment`}
>
  <div class="lab-toolbar">
    <div class="lab-toolbar__identity">
      <strong>Mechanism Lab</strong>
      <span>analytic · ideal {routing} belt</span>
    </div>
    <div class="lab-toolbar__actions">
      <button type="button" data-play aria-pressed="false">Play</button>
      <button type="button" data-reset>Reset</button>
    </div>
  </div>

  <div class="lab-stage">
    <div class="lab-renderer" data-renderer aria-label={`Interactive ${routing} belt drive diagram`}></div>
    <div class="lab-status" data-status aria-live="polite">Drag a handle or change a parameter.</div>
    <noscript>
      <p style="padding: 1rem">The interactive diagram requires JavaScript; the explanation and equations below remain available.</p>
    </noscript>
  </div>

  <div class="lab-console">
    <div class="lab-controls" aria-label="Mechanism parameters">
      <div class="control-row">
        <label for={inputId}>Input angle</label>
        <input id={inputId} data-angle type="range" min="0" max="360" step="1" value="0" />
        <output data-angle-output for={inputId}>0°</output>
      </div>
      <div class="control-row">
        <label for={centerId}>Center distance</label>
        <input id={centerId} data-center type="range" min={centerMin} max="260" step="1" value="180" />
        <output data-center-output for={centerId}>180 mm</output>
      </div>
      <div class="control-row">
        <label for={rpmId}>Driver speed</label>
        <input id={rpmId} data-rpm type="range" min="10" max="120" step="1" value="30" />
        <output data-rpm-output for={rpmId}>30 rpm</output>
      </div>
    </div>

    <div class="lab-readouts" aria-label="Calculated mechanism values">
      <div class="readout"><span>Output direction</span><strong data-direction>{direction}</strong></div>
      <div class="readout"><span>Speed ratio</span><strong data-ratio>0.500</strong></div>
      <div class="readout"><span>Output speed</span><strong data-output-rpm>15.0 rpm</strong></div>
      <div class="readout"><span>Belt speed</span><strong data-belt-speed>0.094 m/s</strong></div>
      <div class="readout"><span>Driver wrap</span><strong data-driver-wrap>—</strong></div>
      <div class="readout"><span>Ideal belt length</span><strong data-belt-length>—</strong></div>
    </div>
  </div>
</section>

<script>
  import '../scripts/beltDriveLab.ts';
</script>
