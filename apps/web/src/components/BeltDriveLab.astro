---
interface Props {
  routing: 'open' | 'crossed';
}

const { routing } = Astro.props;
const crossed = routing === 'crossed';
const inputId = `belt-${routing}-angle`;
const centerId = `belt-${routing}-center`;
const rpmId = `belt-${routing}-rpm`;
const centerMin = 95;
const direction = crossed ? 'Reversed' : 'Same';
---

<section
  class="mechanism-lab"
  data-belt-drive-lab
  data-routing={routing}
  data-view-mode="2d"
  aria-label={`Interactive ${routing} belt drive experiment`}
>
  <div class="lab-toolbar">
    <div class="lab-toolbar__identity">
      <strong>Mechanism Lab</strong>
      <span>analytic · ideal {routing} belt</span>
    </div>
    <div class="lab-toolbar__actions">
      <div class="lab-view-mode" role="group" aria-label="Mechanism view">
        <button type="button" data-view-2d aria-pressed="true">2D</button>
        <button type="button" data-view-3d aria-pressed="false">3D</button>
      </div>
      <button type="button" data-play aria-pressed="false">Play</button>
      <button type="button" data-reset>Reset</button>
    </div>
  </div>

  <div class="lab-stage">
    <div class="lab-viewport" data-lab-viewport>
      <div class="lab-camera" data-lab-camera>
        <div
          class="lab-renderer lab-renderer--2d"
          data-renderer
          aria-label={`Interactive ${routing} belt drive diagram`}
        ></div>
        <div
          class="lab-renderer lab-renderer--three"
          data-renderer-three
          aria-label={`Interactive 3D ${routing} belt drive diagram`}
          hidden
        ></div>
      </div>
      <div class="lab-view-controls" role="group" aria-label="Diagram camera controls">
        <button type="button" data-zoom-out aria-label="Zoom out">−</button>
        <button type="button" data-zoom-fit aria-label="Fit mechanism to viewport">100%</button>
        <button type="button" data-zoom-in aria-label="Zoom in">+</button>
      </div>
    </div>
    <div class="lab-status" data-status aria-live="polite">Drag the mechanism or change a parameter.</div>
    <noscript>
      <p style="padding: 1rem">The interactive diagram requires JavaScript; the explanation and equations below remain available.</p>
    </noscript>
  </div>

  <div class="lab-console">
    <div class="lab-controls" aria-label="Mechanism parameters">
      <div class="control-row">
        <label for={inputId}>Input angle</label>
        <input id={inputId} data-angle type="range" min="0" max="360" step="1" value="0" />
        <output data-angle-output for={inputId}>0°</output>
      </div>
      <div class="control-row">
        <label for={centerId}>Center distance</label>
        <input id={centerId} data-center type="range" min={centerMin} max="260" step="1" value="180" />
        <output data-center-output for={centerId}>180 mm</output>
      </div>
      <div class="control-row">
        <label for={rpmId}>Driver speed</label>
        <input id={rpmId} data-rpm type="range" min="10" max="120" step="1" value="30" />
        <output data-rpm-output for={rpmId}>30 rpm</output>
      </div>
    </div>

    <div class="lab-readouts" aria-label="Calculated mechanism values">
      <div class="readout"><span>Output direction</span><strong data-direction>{direction}</strong></div>
      <div class="readout"><span>Speed ratio</span><strong data-ratio>1.000</strong></div>
      <div class="readout"><span>Output speed</span><strong data-output-rpm>30.0 rpm</strong></div>
      <div class="readout"><span>Belt speed</span><strong data-belt-speed>0.141 m/s</strong></div>
      <div class="readout"><span>Driver wrap</span><strong data-driver-wrap>—</strong></div>
      <div class="readout"><span>Ideal belt length</span><strong data-belt-length>—</strong></div>
    </div>
  </div>
</section>

<script>
  import '../scripts/beltDriveLab.ts';
</script>

<style>
  .lab-stage {
    min-height: 0;
  }

  .lab-view-mode {
    display: flex;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: rgba(233,228,216,.35);
  }

  .lab-view-mode button {
    min-height: 28px;
    padding: 0 9px;
    border: 0;
    background: transparent;
    font-size: 10px;
  }

  .lab-view-mode button[aria-pressed="true"] {
    background: var(--surface-strong);
    color: var(--ink);
    box-shadow: 0 1px 3px rgba(28,29,27,.08);
  }

  /* The stage is a camera viewport rather than a canvas whose height is derived
     from the full desktop width. The product script sizes this viewport to the
     remaining first-screen height, then fits an undistorted 8:5 renderer inside
     it. The same camera frame hosts either the Brown SVG plate or the real 3D
     renderer, so switching modes never changes page composition. */
  .lab-viewport {
    position: relative;
    width: 100%;
    min-height: 0;
    aspect-ratio: 8 / 5;
    overflow: hidden;
  }

  .lab-camera {
    --lab-zoom: 1;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%) scale(var(--lab-zoom));
    transform-origin: center;
  }

  .lab-renderer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .lab-renderer--three {
    cursor: grab;
  }

  .lab-renderer--three:active {
    cursor: grabbing;
  }

  .lab-renderer[hidden] {
    display: none !important;
  }

  .lab-view-controls {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(251,250,246,.92);
    box-shadow: 0 2px 8px rgba(28,29,27,.07);
  }

  .lab-view-controls button {
    min-width: 30px;
    min-height: 30px;
    padding: 0 7px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
  }

  .lab-view-controls button:hover,
  .lab-view-controls button:focus-visible {
    background: rgba(233,228,216,.6);
  }

  .lab-view-controls button:disabled {
    opacity: .35;
    cursor: default;
  }

  [data-zoom-fit] {
    min-width: 48px !important;
    font-family: var(--mono);
    font-size: 10px !important;
  }

  @media (min-width: 641px) {
    .lab-viewport {
      height: min(50svh, 520px);
      aspect-ratio: auto;
    }

    .lab-camera {
      width: min(100%, 832px);
      height: auto;
      aspect-ratio: 8 / 5;
    }
  }

  @media (max-width: 640px) {
    .lab-stage,
    .lab-renderer {
      height: auto;
      min-height: 0;
    }

    .lab-toolbar__actions {
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .lab-view-mode {
      order: -1;
    }

    .lab-status {
      position: static;
      width: fit-content;
      max-width: calc(100% - 30px);
      margin: 8px 15px 14px;
    }

    .lab-view-controls {
      top: 8px;
      right: 8px;
      transform: scale(.92);
      transform-origin: top right;
    }
  }
</style>
