---
import {
  buildLabEvaluationRequest,
  controlLabel,
  defaultLabValues,
  formatLabReadout,
  readoutLabel,
  resolveMechanismLab,
  type LabControlDefinition,
} from '@atlasmechanica/lab';

interface Props {
  modelId: string;
  adapterId: string;
  title: string;
}

const { modelId, adapterId, title } = Astro.props;
const resolved = resolveMechanismLab(modelId, adapterId);
const { definition, model, adapter } = resolved;
const initialValues = defaultLabValues(definition);
const initialRequest = buildLabEvaluationRequest(definition, initialValues);
const initialSession = adapter.compile(model).createSession(
  definition.sessionConfiguration === undefined
    ? undefined
    : { configuration: definition.sessionConfiguration },
);
const initialState = initialSession.evaluate(initialRequest);
const supports3d = definition.views.includes('3d');
const componentId = definition.id.replaceAll(/[^a-zA-Z0-9_-]/g, '-');
const legacyBeltRouting = modelId === 'foundation:belt-drive:open'
  ? 'open'
  : modelId === 'foundation:belt-drive:crossed'
    ? 'crossed'
    : undefined;

function controlValue(control: LabControlDefinition): string {
  const value = control.initial;
  if (control.unit === 'deg') return `${Math.round(value)}°`;
  if (control.unit === 'mm') return `${Math.round(value)} mm`;
  if (control.unit === 'rpm') return `${Math.round(value)} rpm`;
  return `${value} ${control.unit}`;
}
---

<section
  class="mechanism-lab"
  data-mechanism-lab
  data-belt-drive-lab={legacyBeltRouting === undefined ? undefined : ''}
  data-routing={legacyBeltRouting}
  data-model-id={modelId}
  data-adapter-id={adapterId}
  data-view-mode="2d"
  aria-label={`Interactive ${title} experiment`}
>
  <div class="lab-toolbar">
    <div class="lab-toolbar__identity">
      <strong>Mechanism Lab</strong>
      <span>{definition.subtitle ?? model.variant ?? model.subject}</span>
    </div>
    <div class="lab-toolbar__actions">
      {supports3d && (
        <div class="lab-view-mode" role="group" aria-label="Mechanism view">
          <button type="button" data-view-2d aria-pressed="true">2D</button>
          <button type="button" data-view-3d aria-pressed="false">3D</button>
        </div>
      )}
      {definition.animation && <button type="button" data-play aria-pressed="false">Play</button>}
      <button type="button" data-reset>Reset</button>
    </div>
  </div>

  <div class="lab-stage">
    <div class="lab-viewport" data-lab-viewport>
      <div class="lab-camera" data-lab-camera>
        <div
          class="lab-renderer lab-renderer--2d"
          data-renderer
          aria-label={`Interactive ${title} diagram`}
        ></div>
        {supports3d && (
          <div
            class="lab-renderer lab-renderer--three"
            data-renderer-three
            aria-label={`Interactive 3D ${title} diagram`}
            hidden
          ></div>
        )}
      </div>
      <div class="lab-view-controls" role="group" aria-label="Diagram camera controls">
        <button type="button" data-zoom-out aria-label="Zoom out">−</button>
        <button type="button" data-zoom-fit aria-label="Fit mechanism to viewport">100%</button>
        <button type="button" data-zoom-in aria-label="Zoom in">+</button>
      </div>
    </div>
    <div class="lab-status" data-status aria-live="polite">Drag the mechanism or change a parameter.</div>
    <noscript>
      <p style="padding: 1rem">The interactive diagram requires JavaScript; the explanation and equations below remain available.</p>
    </noscript>
  </div>

  <div class="lab-console">
    <div class="lab-controls" aria-label="Mechanism parameters">
      {definition.controls.map((control) => {
        const inputId = `${componentId}-${control.id}`;
        const legacyAngle = legacyBeltRouting !== undefined && control.id === 'driver-angle';
        const legacyCenter = legacyBeltRouting !== undefined && control.id === 'center-distance';
        const legacyRpm = legacyBeltRouting !== undefined && control.id === 'driver-speed';
        return (
          <div class="control-row">
            <label for={inputId}>{controlLabel(control, model)}</label>
            <input
              id={inputId}
              data-control-id={control.id}
              data-angle={legacyAngle ? '' : undefined}
              data-center={legacyCenter ? '' : undefined}
              data-rpm={legacyRpm ? '' : undefined}
              type="range"
              min={control.min}
              max={control.max}
              step={control.step}
              value={control.initial}
            />
            <output
              data-control-output-id={control.id}
              data-angle-output={legacyAngle ? '' : undefined}
              data-center-output={legacyCenter ? '' : undefined}
              data-rpm-output={legacyRpm ? '' : undefined}
              for={inputId}
            >{controlValue(control)}</output>
          </div>
        );
      })}
    </div>

    <div class="lab-readouts" aria-label="Calculated mechanism values">
      {definition.readouts.map((readout) => (
        <div class="readout">
          <span>{readoutLabel(readout, model)}</span>
          <strong
            data-readout-id={readout.id}
            data-direction={legacyBeltRouting !== undefined && readout.id === 'output-direction' ? '' : undefined}
            data-ratio={legacyBeltRouting !== undefined && readout.id === 'speed-ratio' ? '' : undefined}
            data-output-rpm={legacyBeltRouting !== undefined && readout.id === 'output-speed' ? '' : undefined}
            data-belt-speed={legacyBeltRouting !== undefined && readout.id === 'belt-speed' ? '' : undefined}
            data-driver-wrap={legacyBeltRouting !== undefined && readout.id === 'driver-wrap' ? '' : undefined}
            data-belt-length={legacyBeltRouting !== undefined && readout.id === 'belt-length' ? '' : undefined}
          >{formatLabReadout(readout, initialState)}</strong>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/mechanismLab.ts';
</script>

<style>
  .lab-stage {
    min-height: 0;
  }

  .lab-view-mode {
    display: flex;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: rgba(233,228,216,.35);
  }

  .lab-view-mode button {
    min-height: 28px;
    padding: 0 9px;
    border: 0;
    background: transparent;
    font-size: 10px;
  }

  .lab-view-mode button[aria-pressed="true"] {
    background: var(--surface-strong);
    color: var(--ink);
    box-shadow: 0 1px 3px rgba(28,29,27,.08);
  }

  .lab-viewport {
    position: relative;
    width: 100%;
    min-height: 0;
    aspect-ratio: 8 / 5;
    overflow: hidden;
  }

  .lab-camera {
    --lab-zoom: 1;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%) scale(var(--lab-zoom));
    transform-origin: center;
  }

  .lab-renderer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .lab-renderer--three {
    cursor: grab;
  }

  .lab-renderer--three:active {
    cursor: grabbing;
  }

  .lab-renderer[hidden] {
    display: none !important;
  }

  .lab-view-controls {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(251,250,246,.92);
    box-shadow: 0 2px 8px rgba(28,29,27,.07);
  }

  .lab-view-controls button {
    min-width: 30px;
    min-height: 30px;
    padding: 0 7px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
  }

  .lab-view-controls button:hover,
  .lab-view-controls button:focus-visible {
    background: rgba(233,228,216,.6);
  }

  .lab-view-controls button:disabled {
    opacity: .35;
    cursor: default;
  }

  [data-zoom-fit] {
    min-width: 48px !important;
    font-family: var(--mono);
    font-size: 10px !important;
  }

  @media (min-width: 641px) {
    .lab-viewport {
      height: min(50svh, 520px);
      aspect-ratio: auto;
    }

    .lab-camera {
      width: min(100%, 832px);
      height: auto;
      aspect-ratio: 8 / 5;
    }
  }

  @media (max-width: 640px) {
    .lab-stage,
    .lab-renderer {
      height: auto;
      min-height: 0;
    }

    .lab-toolbar__actions {
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .lab-view-mode {
      order: -1;
    }

    .lab-status {
      position: static;
      width: fit-content;
      max-width: calc(100% - 30px);
      margin: 8px 15px 14px;
    }

    .lab-view-controls {
      top: 8px;
      right: 8px;
      transform: scale(.92);
      transform-origin: top right;
    }
  }
</style>
