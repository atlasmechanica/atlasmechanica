<section class="mechanism-lab" data-open-belt-lab aria-label="Interactive open belt drive experiment">
  <div class="lab-toolbar">
    <div class="lab-toolbar__identity">
      <strong>Mechanism Lab</strong>
      <span>analytic · ideal belt</span>
    </div>
    <div class="lab-toolbar__actions">
      <button type="button" data-play aria-pressed="false">Play</button>
      <button type="button" data-reset>Reset</button>
    </div>
  </div>

  <div class="lab-stage">
    <div class="lab-renderer" data-renderer aria-label="Interactive open belt drive diagram"></div>
    <div class="lab-status" data-status aria-live="polite">Drag a handle or change a parameter.</div>
    <noscript>
      <p style="padding: 1rem">The interactive diagram requires JavaScript; the explanation and equations below remain available.</p>
    </noscript>
  </div>

  <div class="lab-console">
    <div class="lab-controls" aria-label="Mechanism parameters">
      <div class="control-row">
        <label for="belt-angle">Input angle</label>
        <input id="belt-angle" data-angle type="range" min="0" max="360" step="1" value="0" />
        <output data-angle-output for="belt-angle">0°</output>
      </div>
      <div class="control-row">
        <label for="belt-center">Center distance</label>
        <input id="belt-center" data-center type="range" min="45" max="260" step="1" value="180" />
        <output data-center-output for="belt-center">180 mm</output>
      </div>
      <div class="control-row">
        <label for="belt-rpm">Driver speed</label>
        <input id="belt-rpm" data-rpm type="range" min="10" max="120" step="1" value="30" />
        <output data-rpm-output for="belt-rpm">30 rpm</output>
      </div>
    </div>

    <div class="lab-readouts" aria-label="Calculated mechanism values">
      <div class="readout"><span>Output direction</span><strong data-direction>Same</strong></div>
      <div class="readout"><span>Speed ratio</span><strong data-ratio>0.500</strong></div>
      <div class="readout"><span>Output speed</span><strong data-output-rpm>15.0 rpm</strong></div>
      <div class="readout"><span>Belt speed</span><strong data-belt-speed>0.094 m/s</strong></div>
      <div class="readout"><span>Driver wrap</span><strong data-driver-wrap>160.8°</strong></div>
      <div class="readout"><span>Ideal belt length</span><strong data-belt-length>—</strong></div>
    </div>
  </div>
</section>

<script>
  import '../scripts/openBeltLab.ts';
</script>
